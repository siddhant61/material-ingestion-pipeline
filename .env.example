# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Directory Configuration (Optional - defaults will be used if not specified)
# INPUT_DIR=input
# OUTPUT_DIR=output
# DATA_DIR=output/data

# Model Configuration (Optional - defaults to gpt-4o-mini)
# DEFAULT_MODEL=gpt-4o-mini
# COURSE_CONTEXT_MODEL=gpt-4o-mini
# TRANSCRIPT_MODEL=gpt-4o-mini
# SLIDE_MODEL=gpt-4o-mini

# Model Parameters (Optional)
# MODEL_TEMPERATURE=0.2
# MODEL_MAX_TOKENS=4000

# Pipeline Configuration (Optional)
# PIPELINE_VERSION=1.0.0
# LOG_LEVEL=INFO
