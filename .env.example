# Material Ingestion Pipeline - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Keys
# =============================================================================
# OpenAI API key for AI model access
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# AI Model Settings
# =============================================================================
# Primary AI model to use (e.g., gpt-3.5-turbo, gpt-4, gpt-4-turbo)
AI_MODEL_NAME=gpt-3.5-turbo

# Temperature for AI responses (0.0 = deterministic, 1.0 = creative)
# Recommended: 0.2 for structured extraction tasks
AI_MODEL_TEMPERATURE=0.2

# Fallback model if primary model fails
AI_FALLBACK_MODEL=gpt-3.5-turbo

# =============================================================================
# Directory Paths (Optional - defaults are provided)
# =============================================================================
# Base directory of the project (auto-detected if not set)
# BASE_DIR=/path/to/material-ingestion-pipeline

# Input directory for course materials
# INPUT_DIR=/path/to/input

# Output directory for processed data
# OUTPUT_DIR=/path/to/output

# Directory containing course information documents
# COURSE_INFO_DIR=/path/to/input/course_material/course_info

# Directory containing transcript files
# TRANSCRIPTS_DIR=/path/to/input/course_material/transcripts

# Directory containing slide files
# SLIDES_DIR=/path/to/input/course_material/slides

# =============================================================================
# Data Manager Settings
# =============================================================================
# Base directory for data manager storage
DATA_BASE_DIR=output/data
